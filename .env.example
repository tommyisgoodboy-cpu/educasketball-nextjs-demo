# Supabase (local values are printed by `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the site. Used for payment redirect URLs. Include NEXT_PUBLIC_BASE_PATH if you set one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: serve the app under a sub-path, e.g. /demo/edu. Leave empty for the site root.
NEXT_PUBLIC_BASE_PATH=
# Optional: comma-separated hosts allowed to post Server Actions when behind a reverse proxy.
ALLOWED_ORIGINS=
# Set to 1 on a public demo to lock destructive admin actions (settings, roles, uploads).
NEXT_PUBLIC_DEMO_LOCK=

# Optional: Stripe test mode. Without it the payment flow uses the built-in demo payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: phone-number login. Must match the value stored in private.app_secrets
# (see supabase/migrations/20261015000025_phone_login_key.sql). Empty = phone login disabled.
PHONE_LOGIN_KEY=

# Optional: protects /api/keepalive when called by a scheduler.
CRON_SECRET=
